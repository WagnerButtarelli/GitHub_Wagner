<!doctype html><html lang="pt-BR"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Lembretes</title>
<link rel="manifest" href="manifest.json"><meta name="theme-color" content="#B8860B">
<style>body{font-family:'Google Sans',Roboto,system-ui,sans-serif;margin:0;padding:24px;background:#FBF8F1;color:#26231B;text-align:center}
button{min-height:48px;padding:0 22px;border:0;border-radius:24px;background:#B8860B;color:#fff;font-weight:600;font-size:16px;font-family:inherit;margin:6px}
#mic.on{background:#D93025}p{color:#7A7566}#heard{min-height:48px;font-size:18px}
@media(prefers-color-scheme:dark){body{background:#17150F;color:#F2EEE2}}</style></head><body>
<h2>🔔 Lembretes e voz</h2>
<p id="st">Aguardando o app…</p>
<button id="nt" hidden>Ativar notificações</button><br>
<button id="mic">🎤 Ouvir</button><div id="heard"></div>
<script>
const OK=/^https:\/\/([a-z0-9-]+\.)*(googleusercontent|google)\.com$/;
let app=window.opener,appOrigin=null,reg=null,vp=null,rec=null;
const $=s=>document.querySelector(s),st=t=>$('#st').textContent=t;
const post=m=>{if(app&&appOrigin&&!app.closed)app.postMessage(m,appOrigin)};
const IDB=()=>new Promise((ok,er)=>{const r=indexedDB.open('lembretes',1);r.onupgradeneeded=()=>r.result.createObjectStore('kv');r.onsuccess=()=>ok(r.result);r.onerror=er});
const get=async k=>{const d=await IDB();return new Promise(ok=>{const q=d.transaction('kv').objectStore('kv').get(k);q.onsuccess=()=>ok(q.result)})};
const set=async(k,v)=>{const d=await IDB();return new Promise(ok=>{const t=d.transaction('kv','readwrite');t.objectStore('kv').put(v,k);t.oncomplete=ok})};
const u8=s=>{s=s.replace(/-/g,'+').replace(/_/g,'/');const b=atob(s+'='.repeat((4-s.length%4)%4));return Uint8Array.from(b,c=>c.charCodeAt(0))};

async function subscribe(){
  if(!reg||!vp)return;
  if(Notification.permission==='denied')return st('Notificações bloqueadas. Libere nas configurações do navegador para este site.');
  if(Notification.permission!=='granted'){$('#nt').hidden=false;return st('Toque em "Ativar notificações".')}
  try{const s=(await reg.pushManager.getSubscription())||await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:u8(vp)});
    post({type:'sub',sub:s.toJSON()});$('#nt').hidden=true;st('Pronto! Você receberá os lembretes mesmo com o app fechado.')}
  catch(e){st('Não foi possível ativar o envio de avisos: '+e.message)}
}
if(!('Notification' in window)||!('serviceWorker' in navigator)||!('PushManager' in window))
  st('Este navegador não suporta avisos com o app fechado. No iPhone, use "Adicionar à Tela de Início" e abra por lá.');
else navigator.serviceWorker.register('sw.js').then(async r=>{reg=r;await navigator.serviceWorker.ready;vp=await get('vapid');if(vp)subscribe()}).catch(()=>st('Falha ao iniciar o serviço de notificações.'));
$('#nt').onclick=()=>Notification.requestPermission().then(subscribe);

function listen(){const R=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!R){post({type:'voice',error:'unsupported'});return st('Reconhecimento de voz não suportado neste navegador.')}
 if(rec)try{rec.stop()}catch(e){}
 const r=rec=new R();r.lang='pt-BR';r.interimResults=true;let tx='';
 r.onresult=e=>{tx=[...e.results].map(x=>x[0].transcript).join(' ');$('#heard').textContent=tx;post({type:'voice',text:tx,final:false})};
 r.onerror=e=>{post({type:'voice',error:e.error});st('Erro no microfone: '+e.error)};
 r.onend=()=>{$('#mic').classList.remove('on');post({type:'voice',text:tx,final:true})};
 r.start();$('#mic').classList.add('on')}
$('#mic').onclick=listen;

addEventListener('message',async e=>{
 if(!OK.test(e.origin))return;app=e.source;appOrigin=e.origin;const m=e.data||{};
 if(m.type==='init'){vp=m.vapid;await set('vapid',m.vapid);await set('appUrl',m.appUrl);subscribe()}
 if(m.type==='sync'){await set('items',m.items||[]);post({type:'synced'});if(m.close){st('Lembretes sincronizados.');setTimeout(()=>window.close(),1200)}}
 if(m.type==='listen')listen();
});
if(app)try{app.postMessage({type:'ready'},'*')}catch(e){}
</script></body></html>
